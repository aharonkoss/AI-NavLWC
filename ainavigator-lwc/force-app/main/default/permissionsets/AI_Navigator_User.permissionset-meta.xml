<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>AI Navigator User</label>
    <description>Assigned to business users of the AI Navigator app. Grants access to all LWC components, outbound service classes, and read/create permissions on app objects.</description>

    <!-- ── Outbound Service Classes ─────────────────────────────── -->
    <classAccesses>
        <apexClass>AzureUploadService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AzureResearchService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AzureSignalService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AzureScoringService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AI_Navigator_Event_Publisher</apexClass>
        <enabled>true</enabled>
    </classAccesses>
<!-- ── Packaged Apex Controller Access ── -->
    <classAccesses>
        <apexClass>AI_Navigator_SetupController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- ── Custom Metadata — read only ──────────────────────────── -->
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>AI_Navigator_Config__mdt</name>
    </customMetadataTypeAccesses>

    <!-- ── Platform Events — subscribe only ─────────────────────── -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AI_Navigator_Inbound__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AI_Navigator_Outbound__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- ── AI_Navigator_Company__c — full CRUD ────────────────── -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AI_Navigator_Company__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- ── AI_Navigator_Submission__c — full CRUD ─────────────── -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AI_Navigator_Submission__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- ── AI_Navigator_Signals__c — read only ────────────────── -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AI_Navigator_Signals__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- ── AI_Navigator_Request_Log__c — read only ────────────── -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AI_Navigator_Request_Log__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <!-- ── System Permissions ───────────────────────────────────── -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>
    <tabSettings>
        <tab>AI_Navigator</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>